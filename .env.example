# Strict Environment Contract (Required for fail-closed runtime verification)
VITE_APP_PRODUCT=CAMPUS_OS
VITE_APP_ENVIRONMENT=staging
VITE_BUILD_VERSION=1.0.0-staging
VITE_GIT_COMMIT_SHA=commit-sha-placeholder

# Public Firebase browser configuration.
# These values identify the Firebase project used by the web client; they are not server secrets.
VITE_FIREBASE_API_KEY=replace-with-public-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:replace-with-app-id

# Optional analytics.
VITE_GA_MEASUREMENT_ID=

# Server-only secrets such as Gemini, Razorpay, and SMTP credentials must be set
# through Firebase Functions secrets or Google Secret Manager, never Vite env vars.
